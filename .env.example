# Configuración de Base de Datos
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=FacturasDB
DB_USER=usuario
DB_PASSWORD=contraseña

# Rutas de Datos
INPUT_DATA_PATH=data/
OUTPUT_LOG_PATH=logs/

# Configuración de Procesamiento
BATCH_SIZE=1000
ENCODING=utf-8

# Logging
LOG_LEVEL=INFO
